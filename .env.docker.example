# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 64

# ── Database (AWS RDS PostgreSQL or external EC2 host) ─────────────────────────
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=farm360
DB_PASSWORD=change_me
DB_NAME=farm360
SP_DB_NAME=farm360_sp

# ── Secrets ────────────────────────────────────────────────────────────────────
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SP_JWT_SECRET=
SP_REFRESH_TOKEN_SECRET=
INTERNAL_SERVICE_TOKEN=
SUPER_ADMIN_SECRET=

# ── Public App URL (used for email/SMS notifications and app links) ───────────
# Point to your domain or public IP without port (Caddy serves on 80/443):
FRONTEND_URL=http://your-server-ip

# ── Optional: AWS CloudWatch Logs (leave false to log to stdout only) ─────────
CLOUDWATCH_ENABLED=false
AWS_REGION=ap-south-1
CLOUDWATCH_LOG_GROUP=/farm360/production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Optional: SMTP Email Notifications ────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
